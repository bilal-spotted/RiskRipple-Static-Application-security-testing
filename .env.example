# Copy to .env and fill in. Never commit .env - it is gitignored.
# Every setting below is OPTIONAL. The scanner is fully functional without any
# of it: AI review is an advisory extra, not a dependency.

# --- AI-assisted review (optional) ---
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# The default model runs on Gemini's free tier.
# GEMINI_API_KEY=

# Override the model if the default is retired or you prefer another.
# Free-tier options include gemini-2.5-flash, gemini-2.5-flash-lite,
# gemini-3.5-flash. Default: gemini-2.5-flash
# RISKRIPPLE_AI_MODEL=

# Provider to use. Default: gemini
# RISKRIPPLE_AI_PROVIDER=

# Cost controls. Defaults: 10 files per run, 12000 characters per file.
# RISKRIPPLE_AI_MAX_FILES=
# RISKRIPPLE_AI_MAX_CHARS=

# Where cached AI responses are stored. Default: ~/.cache/riskripple/ai
# RISKRIPPLE_AI_CACHE_DIR=

# --- Web interface (optional) ---
# WEBAPP_HOST=127.0.0.1
# WEBAPP_PORT=8000
# WEBAPP_SECRET_KEY=
# WEBAPP_OUTPUT_ROOT=
